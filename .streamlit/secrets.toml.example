# 이 파일을 복사해서 .streamlit/secrets.toml 을 만들고 값을 채우세요.
# secrets.toml 은 .gitignore 로 제외되어 커밋되지 않습니다. (값은 팀 메신저로만 공유)

# Firebase 콘솔 → 프로젝트 설정 → 일반 → 웹 API 키
firebase_web_api_key = "AIza..."

# 영상 원본·결과 파일 저장 위치 (JCloud 에서는 영구 저장 디스크 경로)
storage_dir = "./data/storage"

# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 (JSON 내용을 옮겨 적기)
[firebase_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
